STOCK_COOLDOWN_DAYS=7
STOCK_OWN_MAX_STOCK=0
STOCK_MIN_ORDERS=5
STOCK_REQUIRE_BUYOUTS=true
STOCK_MAX_TASKS=10
STOCK_ASSIGNEE_TELEGRAM_ID=0

# WB Dashboard → полки у моих (Вт/Чт): доля своих в топ-15 < порога
SHELF_WATCH_ENABLED=true
